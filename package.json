{
  "name": "mobile-monorepo",
  "private": true,
  "scripts": {
    "test": "npm run test:web && npm run test:api && npm run test:mobile",
    "test:web": "npm --prefix apps/web run test",
    "test:api": "npm --prefix apps/api run test",
    "test:mobile": "npm --prefix apps/mobile run test",
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:mobile\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:mobile": "npm --prefix apps/mobile run start"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "concurrently": "^7.6.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "lucide-react": "^0.564.0"
  }
}
