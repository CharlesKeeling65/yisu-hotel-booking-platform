FROM node:24-alpine AS build

WORKDIR /app/apps/mobile

ARG EXPO_PUBLIC_API_BASE_URL=
ENV EXPO_PUBLIC_API_BASE_URL=${EXPO_PUBLIC_API_BASE_URL}

COPY apps/mobile/package.json apps/mobile/package-lock.json ./
COPY packages/shared /app/packages/shared
RUN npm install --no-audit --no-fund --progress=false \
  --maxsockets=4 --fetch-retries=5 \
  --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000

COPY apps/mobile .
RUN npx expo export --platform web --output-dir dist --clear --base-url /mobile

FROM nginx:1.27-alpine

COPY nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
